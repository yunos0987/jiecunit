{#include <jiecunit.iec>}

// Test internal validation functions directly
TEST_S(test_jiectest_validate_ge)
	var
		jt: JiecTest_t;
	end
	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_INT32(jt, 2, 1, 'INT32: 2 >= 1', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_INT32(jt, 2, 2, 'INT32: 2 >= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_INT32(jt, 1, 2, 'INT32: 1 >= 2', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_UINT32(jt, 2, 1, 'UINT32: 2 >= 1', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_UINT32(jt, 2, 2, 'UINT32: 2 >= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_UINT32(jt, 1, 2, 'UINT32: 1 >= 2', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_DOUBLE(jt, 2.0, 1.0, 'DOUBLE: 2.0 >= 1.0', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_DOUBLE(jt, 2.0, 2.0, 'DOUBLE: 2.0 >= 2.0', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_DOUBLE(jt, 1.0, 2.0, 'DOUBLE: 1.0 >= 2.0', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_STRING(jt, 'B', 'A', 'STRING: "B" >= "A"', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_STRING(jt, 'A', 'A', 'STRING: "A" >= "A"', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_STRING(jt, 'A', 'B', 'STRING: "A" >= "B"', false, TestName, __LINE__, '', ''));
{#if not (_KEYENCE or _MITSUBISHI)}
	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_TIME(jt, time#2s, time#1s, 'TIME: 2s >= 1s', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_TIME(jt, time#2s, time#2s, 'TIME: 2s >= 2s', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_TIME(jt, time#1s, time#2s, 'TIME: 1s >= 2s', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_DATE(jt, date#2026-03-19, date#2026-03-18, 'DATE: 2026-03-19 >= 2026-03-18', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_DATE(jt, date#2026-03-18, date#2026-03-18, 'DATE: equal dates', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_DATE(jt, date#2026-03-18, date#2026-03-19, 'DATE: 2026-03-18 >= 2026-03-19', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_TOD(jt, tod#12:34:57, tod#12:34:56, 'TOD: 12:34:57 >= 12:34:56', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_TOD(jt, tod#12:34:56, tod#12:34:56, 'TOD: equal times', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_TOD(jt, tod#12:34:56, tod#12:34:57, 'TOD: 12:34:56 >= 12:34:57', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_DT(jt, dt#2026-03-18-12:34:57, dt#2026-03-18-12:34:56, 'DT: 12:34:57 >= 12:34:56', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_DT(jt, dt#2026-03-18-12:34:56, dt#2026-03-18-12:34:56, 'DT: equal timestamps', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_DT(jt, dt#2026-03-18-12:34:56, dt#2026-03-18-12:34:57, 'DT: 12:34:56 >= 12:34:57', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_INT64(jt, 2, 1, 'INT64: 2 >= 1', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_INT64(jt, 2, 2, 'INT64: 2 >= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_INT64(jt, 1, 2, 'INT64: 1 >= 2', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateGE_UINT64(jt, 2, 1, 'UINT64: 2 >= 1', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateGE_UINT64(jt, 2, 2, 'UINT64: 2 >= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateGE_UINT64(jt, 1, 2, 'UINT64: 1 >= 2', false, TestName, __LINE__, '', ''));
{#endif}
END_TEST_S

// Test EXPECT_GE and ASSERT_GE macros with all data types
TEST_S(test_ge_macro)
	EXPECT_GE_INT(2, 1);
	EXPECT_GE_INT(2, 2);
	EXPECT_GE_INT(0, -1);
	EXPECT_GE_UINT(1, 0);
	EXPECT_GE_DOUBLE(0.0, -1.0);
	EXPECT_GE_DOUBLE(1.0, 1.0);
	EXPECT_GE_STRING('B', 'A');
	EXPECT_GE_STRING('A', 'A');
{#if not (_KEYENCE or _MITSUBISHI)}
	EXPECT_GE_TIME(time#2s, time#1s);
	EXPECT_GE_TIME(time#2s, time#2s);
	EXPECT_GE_DATE(date#2026-03-19, date#2026-03-18);
	EXPECT_GE_TOD(tod#12:34:57, tod#12:34:56);
	EXPECT_GE_DT(dt#2026-03-18-12:34:57, dt#2026-03-18-12:34:56);
	ASSERT_GE_DATE(date#2026-03-19, date#2026-03-18);
	ASSERT_GE_TOD(tod#12:34:57, tod#12:34:56);
	ASSERT_GE_DT(dt#2026-03-18-12:34:57, dt#2026-03-18-12:34:56);
{#endif}
	// ...他データ型・メッセージ・ASSERT_GEも同様に追加...
END_TEST_S
