{#include <jiecunit.iec>}

// Test internal validation functions directly
TEST_S(test_jiectest_validate_le)
	var
		jt: JiecTest_t;
	end
	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_INT32(jt, 1, 2, 'INT32: 1 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_INT32(jt, 2, 2, 'INT32: 2 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_INT32(jt, 3, 2, 'INT32: 3 <= 2', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_UINT32(jt, 1, 2, 'UINT32: 1 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_UINT32(jt, 2, 2, 'UINT32: 2 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_UINT32(jt, 3, 2, 'UINT32: 3 <= 2', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_DOUBLE(jt, 1.0, 2.0, 'DOUBLE: 1.0 <= 2.0', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_DOUBLE(jt, 2.0, 2.0, 'DOUBLE: 2.0 <= 2.0', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_DOUBLE(jt, 3.0, 2.0, 'DOUBLE: 3.0 <= 2.0', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_STRING(jt, 'A', 'B', 'STRING: "A" <= "B"', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_STRING(jt, 'A', 'A', 'STRING: "A" <= "A"', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_STRING(jt, 'B', 'A', 'STRING: "B" <= "A"', false, TestName, __LINE__, '', ''));

{#if not (_KEYENCE or _MITSUBISHI)}
	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_TIME(jt, time#1s, time#2s, 'TIME: 1s <= 2s', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_TIME(jt, time#2s, time#2s, 'TIME: 2s <= 2s', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_TIME(jt, time#3s, time#2s, 'TIME: 3s <= 2s', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_DATE(jt, date#2026-03-18, date#2026-03-19, 'DATE: 2026-03-18 <= 2026-03-19', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_DATE(jt, date#2026-03-18, date#2026-03-18, 'DATE: equal dates', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_DATE(jt, date#2026-03-20, date#2026-03-19, 'DATE: 2026-03-20 <= 2026-03-19', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_TOD(jt, tod#12:34:56, tod#12:34:57, 'TOD: 12:34:56 <= 12:34:57', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_TOD(jt, tod#12:34:56, tod#12:34:56, 'TOD: equal times', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_TOD(jt, tod#12:34:58, tod#12:34:57, 'TOD: 12:34:58 <= 12:34:57', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_DT(jt, dt#2026-03-18-12:34:56, dt#2026-03-18-12:34:57, 'DT: 12:34:56 <= 12:34:57', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_DT(jt, dt#2026-03-18-12:34:56, dt#2026-03-18-12:34:56, 'DT: equal timestamps', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_DT(jt, dt#2026-03-18-12:34:58, dt#2026-03-18-12:34:57, 'DT: 12:34:58 <= 12:34:57', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_INT64(jt, 1, 2, 'INT64: 1 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_INT64(jt, 2, 2, 'INT64: 2 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_INT64(jt, 3, 2, 'INT64: 3 <= 2', false, TestName, __LINE__, '', ''));

	JiecTest_initialize(jt);
	EXPECT_TRUE(JiecTest_validateLE_UINT64(jt, 1, 2, 'UINT64: 1 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_TRUE(JiecTest_validateLE_UINT64(jt, 2, 2, 'UINT64: 2 <= 2', false, TestName, __LINE__, '', ''));
	EXPECT_FALSE(JiecTest_validateLE_UINT64(jt, 3, 2, 'UINT64: 3 <= 2', false, TestName, __LINE__, '', ''));
{#endif}
END_TEST_S

// Test EXPECT_LE and ASSERT_LE macros with all data types
TEST_S(test_le_macro)
	EXPECT_LE_INT(1, 2);
	EXPECT_LE_INT(2, 2);
	EXPECT_LE_INT(-1, 0);
	EXPECT_LE_UINT(0, 1);
	EXPECT_LE_DOUBLE(-1.0, 0.0);
	EXPECT_LE_DOUBLE(1.0, 1.0);
	EXPECT_LE_STRING('A', 'B');
	EXPECT_LE_STRING('A', 'A');
{#if not (_KEYENCE or _MITSUBISHI)}
	EXPECT_LE_TIME(time#2s, time#2s);
	EXPECT_LE_DATE(date#2026-03-18, date#2026-03-19);
	EXPECT_LE_TOD(tod#12:34:56, tod#12:34:57);
	EXPECT_LE_DT(dt#2026-03-18-12:34:56, dt#2026-03-18-12:34:57);
	ASSERT_LE_DATE(date#2026-03-18, date#2026-03-19);
	ASSERT_LE_TOD(tod#12:34:56, tod#12:34:57);
	ASSERT_LE_DT(dt#2026-03-18-12:34:56, dt#2026-03-18-12:34:57);
{#endif}	
	// ...他データ型・メッセージ・ASSERT_LEも同様に追加...
END_TEST_S
