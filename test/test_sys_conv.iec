TEST_S(test_bool_to_string)
{#if not (_CODESYS)}
	EXPECT_EQ_STRING('true', bool_to_string(true));
	EXPECT_EQ_STRING('false', bool_to_string(false));
{#else}
	EXPECT_EQ_STRING('TRUE', bool_to_string(true));
	EXPECT_EQ_STRING('FALSE', bool_to_string(false));
{#endif}
	EXPECT_EQ_BOOL(1=2, 3=4);
END_TEST_S

// note: Microsecond precision per Keyence specifications.; see TimeToMicroSec function.
// note: CODESYS does not support negative time values.
TEST_S(test_time_to_literal)
	var
		tiny: time;
	end
	// Fact: a duration is written as a duration literal; parts that are 0 are left out.
	EXPECT_EQ_STRING('T#0s', time_to_literal(time#0s));
	EXPECT_EQ_STRING('T#1s', time_to_literal(time#1.000000s));
	EXPECT_EQ_STRING('T#3s', time_to_literal(time#3s));
	EXPECT_EQ_STRING('T#1m', time_to_literal(time#60s));
	EXPECT_EQ_STRING('T#1h', time_to_literal(time#3600s));
	EXPECT_EQ_STRING('T#1d', time_to_literal(time#24h));
	EXPECT_EQ_STRING('T#1h30m5s250ms', time_to_literal(time#1h30m5s250ms));
	EXPECT_EQ_STRING('T#1d2h3m4s5ms', time_to_literal(time#1d2h3m4s5ms));
	EXPECT_EQ_STRING('T#1h5ms', time_to_literal(time#1h5ms));

	// Fact: a fraction of a second is written in milliseconds, with a decimal point below a millisecond.
	EXPECT_EQ_STRING('T#123.456ms', time_to_literal(time#0.123456s));
	EXPECT_EQ_STRING('T#1s234.567ms', time_to_literal(time#1.234567s));
	EXPECT_EQ_STRING('T#1s200ms', time_to_literal(time#1.2s));
	EXPECT_EQ_STRING('T#1s20ms', time_to_literal(time#1.02s));
	EXPECT_EQ_STRING('T#1s20.3ms', time_to_literal(time#1.0203s));
	EXPECT_EQ_STRING('T#999.999ms', time_to_literal(time#0.999999s));
	EXPECT_EQ_STRING('T#1s0.001ms', time_to_literal(time#1.000001s));
	EXPECT_EQ_STRING('T#0.5ms', time_to_literal(time#0.5ms));

	// Fact: nanoseconds are the last digits of the fraction.
	tiny := time#1ms / 1000000;
	EXPECT_EQ_STRING('T#0.000001ms', time_to_literal(tiny));
	EXPECT_EQ_STRING('T#250.123456ms', time_to_literal(time#250ms + tiny * 123456));

	// Fact: durations longer than a DINT of microseconds (about 35m47s) are not cut off.
	EXPECT_EQ_STRING('T#35m47s483.647ms', time_to_literal(time#2147483.647ms));
	EXPECT_EQ_STRING('T#35m47s483.648ms', time_to_literal(time#2147483.648ms));
	EXPECT_EQ_STRING('T#2h', time_to_literal(time#2h));
	EXPECT_EQ_STRING('T#100d', time_to_literal(time#100d));
	EXPECT_EQ_STRING('T#10000d23h59m59s999.999999ms', time_to_literal(time#10001d - tiny));

	// Fact: a negative duration has the sign after T#.
	EXPECT_EQ_STRING('T#-1s', time_to_literal(time#0s - time#1s));
	EXPECT_EQ_STRING('T#-1h500ms', time_to_literal(time#0s - time#1h500ms));
	EXPECT_EQ_STRING('T#-0.001ms', time_to_literal(time#0s - time#0.001ms));

	// Fact: jiec_time_quotient counts the whole units.
	EXPECT_EQ_DINT(0, jiec_time_quotient(time#999ms, time#1s));
	EXPECT_EQ_DINT(1, jiec_time_quotient(time#1s, time#1s));
	EXPECT_EQ_DINT(86399, jiec_time_quotient(time#1d - time#1ms, time#1s));
	EXPECT_EQ_DINT(36500, jiec_time_quotient(time#36500d12h, time#1d));
END_TEST_S
