// A list placed before the test definitions (the older form, with extern program
// stubs) is accepted without the count check: the listed test runs, and a test
// missing from the list does not run and is not reported.
{#include <jiecunit.iec>}

DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_one
	)
)

TEST_S(test_one)
	EXPECT_TRUE(true);
END_TEST_S

TEST_S(test_not_listed)
	FAIL('must not run');
END_TEST_S
