// The console warning also follows the list of failed tests.
{#include <jiecunit.iec>}

TEST_S(test_fails)
	EXPECT_EQ_INT(1, 2);
END_TEST_S

TEST_S(test_passes)
	EXPECT_TRUE(true);
END_TEST_S

