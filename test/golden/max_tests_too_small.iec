// golden-args: -D MAX_TESTS=1
// More names in _JIEC_TESTNAMES_LIST_ than MAX_TESTS stops the preprocessor
// (the PLC targets would otherwise get an array with a negative repetition).
{#include <jiecunit.iec>}

TEST_S(test_one)
	EXPECT_TRUE(true);
END_TEST_S

TEST_S(test_two)
	EXPECT_TRUE(true);
END_TEST_S

DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_one,
		test_two
	)
)
