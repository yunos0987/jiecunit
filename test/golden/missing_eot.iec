// golden-args: -D JIECUNIT_MAX_CYCLES_PER_TEST=5 --max-cycles 100
// A TEST_M without EOT() fails when it reaches JIECUNIT_MAX_CYCLES_PER_TEST,
// and the next test still runs.
{#include <jiecunit.iec>}

TEST_M(test_without_eot)
	EXPECT_TRUE(true);
END_TEST_M

TEST_S(test_after)
	EXPECT_TRUE(true);
END_TEST_S

DEFINE_CONFIGURATION(
	_JIEC_TESTNAMES_LIST_(
		test_without_eot,
		test_after
	)
)
