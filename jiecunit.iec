{#define EXPECT_EQ_UINT32_MSG(expected, actual, message)    _VALIDATE_EQ_UINT32_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
