{#define EXPECT_EQ_INT32_MSG(expected, actual, message)     _VALIDATE_EQ_INT32_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
{#define EXPECT_EQ_INT64_MSG(expected, actual, message)     _VALIDATE_EQ_INT64_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}

{#define EXPECT_EQ_USINT_MSG(expected, actual, message)     _VALIDATE_EQ_UINT32_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
{#define EXPECT_EQ_UINT_MSG(expected, actual, message)      _VALIDATE_EQ_UINT32_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
