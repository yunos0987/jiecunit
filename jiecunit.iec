{#define _JIECUNIT_OPTMSG3_14(base, die, ...)                            _JIECUNIT_BAD_ARGC_(3, 4)}
{#define _JIECUNIT_OPTMSG3_15(base, die, ...)                            _JIECUNIT_BAD_ARGC_(3, 4)}
{#define _JIECUNIT_OPTMSG3_16(base, die, ...)                            _JIECUNIT_BAD_ARGC_(3, 4)}
{#define _JIECUNIT_OPTMSG3_N(n, base, die, ...)                          _JIECUNIT_OPTMSG3_ @@ n(base, die, __VA_ARGS__)}

