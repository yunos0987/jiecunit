{#define _JIECUNIT_OPTFAIL_0(die, ...)                                   _VALIDATE_FAILURE_(die, '')}
{#define _JIECUNIT_OPTFAIL_1(die, m)                                     _VALIDATE_FAILURE_(die, m)}
{#define _JIECUNIT_OPTFAIL_2(die, ...)                                   _JIECUNIT_BAD_ARGC_(0, 1)}
