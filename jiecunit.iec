{#define EXPECT_EQ_REAL_MSG(expected, actual, message)      _VALIDATE_EQ_FLOAT_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))} (* Exact; see also EXPECT_FLOAT_EQ / EXPECT_DOUBLE_EQ and EXPECT_NEAR *)
{#define EXPECT_EQ_LREAL_MSG(expected, actual, message)     _VALIDATE_EQ_DOUBLE_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))} (* Exact; see also EXPECT_FLOAT_EQ / EXPECT_DOUBLE_EQ and EXPECT_NEAR *)
{#define EXPECT_EQ_FLOAT_MSG(expected, actual, message)     _VALIDATE_EQ_FLOAT_MSG(false, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))} (* Exact; see also EXPECT_FLOAT_EQ / EXPECT_DOUBLE_EQ and EXPECT_NEAR *)
