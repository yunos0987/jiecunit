// ---------------------------------------------------------------------- //
// Optional-message dispatchers (internal; do not use directly).
//
// Every public assertion macro declares its required arguments by name and
// takes an optional trailing message argument through a variadic tail:
//   EXPECT_EQ_INT(expected, actual)            -> message is ''
//   EXPECT_EQ_INT(expected, actual, message)   -> message is used
//   EXPECT_EQ_INT(1)                           -> too few required args
//   EXPECT_EQ_INT(1, 2, 3, 4)                  -> too many total args
//
// _JIECUNIT_OPTMSG<K>_N(n, base, ...) dispatches on n = __VA_ARGC__, the
// number of arguments AFTER the required ones (0 when the message is
// omitted, 1 when it is given), to base @@ _MSG(...), appending '' when the
// message is omitted. K is the number of required value arguments the
// assertion takes (1: TRUE/FALSE, 2: EQ/NE/LT/LE/GE/GT, 3: NEAR/NEAR_REL).
// _JIECUNIT_OPTFAIL_N is the K=0 counterpart used by FAIL/ADD_FAILURE, which
// take no value argument. _JIECUNIT_BAD_ARGC_(lo, hi) instead takes lo/hi as
// the TOTAL argument count of the call (required args + message), which is
// not the same quantity as n.
//
// K=1 (TRUE/FALSE) additionally takes fixed_, a BOOL literal the public
// macro itself bakes in (true for EXPECT_TRUE, false for EXPECT_FALSE) to
// pick which value condition is compared against. fixed_ is not one of the
// caller-supplied required arguments, so _JIECUNIT_OPTMSG1_*'s value
// arguments are `fixed_, v1` (2 total), not just v1.
// _JIECUNIT_OPTFAIL_N does not take a base at all: FAIL/ADD_FAILURE have
// only one possible outcome, so its buckets expand straight to
// _VALIDATE_FAILURE_(die, message) instead of base @@ _MSG(...).
//
// Every public macro follows this template (square brackets mark the part
// that is only present for K=1):
//   {#define NAME(<required args>, ...)
//       _JIECUNIT_OPTMSG<K>_N(__VA_ARGC__, <base>, <die>, [<fixed>,]
//                              <required args>, __VA_ARGS__)}
// Adding a new K (e.g. K=4 for a future 4-value assertion) means adding a
// new _JIECUNIT_OPTMSG4_0.._16/_N family below that follows this template.
//
// Only bucket _1 receives the message as a named parameter; every other
// bucket keeps a trailing `...` instead, for two different reasons. Bucket
// _0 needs it because when the message is omitted, __VA_ARGS__ at the call
// site expands to nothing and leaves one empty trailing argument that only
// a variadic parameter can absorb. Buckets _2..16 need it because they each
// receive n extra trailing arguments whose content is discarded (the call
// is already wrong), so `...` absorbs however many of them arrived instead
// of naming n separate parameters per bucket.
//
// A wrong TOTAL argument count is reported one of three ways, depending on
// which side of the required arguments the mistake falls on:
//   - Too many trailing arguments (n >= 2): expands to the deliberate syntax
//     error JIECUNIT_ASSERTION_TAKES_<lo>_OR_<hi>_ARGUMENTS, which both
//     `jiecc -c` and `jiecc --run` report at the call site.
//   - Too few required arguments (e.g. EXPECT_EQ_INT(1)): the public macro's
//     named required parameters make the preprocessor itself refuse the
//     call, reporting `PP34: Argument count mismatch` at the call site
//     before this dispatch layer ever runs. `jiecc -c` still exits 0 in
//     this case and writes an XML file that contains no POUs at all, so the
//     exit code alone does not reveal the failure; scripts/run_tests.py
//     detects it by also scanning the output for `error:` lines.
//   - No arguments at all (e.g. EXPECT_FALSE()): expands with one empty
//     argument (`actual:=,`), which `jiecc -c` rejects as `','; INVALID_SYNTAX`
//     at the call site.
//
// Each dispatcher only defines buckets for the 0..16 extra trailing
// arguments beyond the required ones. A call with more extra arguments than
// that falls through to an undefined macro name instead of
// _JIECUNIT_BAD_ARGC_, so `jiecc -c` does not flag it (only `jiecc --run`
// reports UNDEFINED_SYMBOL). If a future assertion needs more arguments,
// raise this limit in all four dispatcher systems together, and update the
// boundary probes in scripts/check_macro_expansion.py's _EXCESS_CASES to
// match the new limit.
//
// FAIL/ADD_FAILURE take no required value argument, so their public macros
// keep the plain `(...)` signature instead of a named parameter.
//
// scripts/check_macro_expansion.py verifies that every one of the 290
// public assertion macros expands identically with and without this
// dispatch layer, so changes here must keep that check passing.
// ---------------------------------------------------------------------- //
{#define _JIECUNIT_BAD_ARGC_(lo, hi)                                     end_var JIECUNIT_ASSERTION_TAKES_ @@ lo @@ _OR_ @@ hi @@ _ARGUMENTS}

{#define _JIECUNIT_OPTMSG1_0(base, die, fixed_, v1, ...)                 base @@ _MSG(die, fixed_, v1, '')}
{#define _JIECUNIT_OPTMSG1_1(base, die, fixed_, v1, m)                   base @@ _MSG(die, fixed_, v1, m)}
{#define _JIECUNIT_OPTMSG1_2(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_3(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_4(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_5(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_6(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_7(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_8(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_9(base, die, fixed_, v1, ...)                 _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_10(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_11(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_12(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_13(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_14(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_15(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_16(base, die, fixed_, v1, ...)                _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_N(n, base, die, fixed_, v1, ...)              _JIECUNIT_OPTMSG1_ @@ n(base, die, fixed_, v1, __VA_ARGS__)}

{#define _JIECUNIT_OPTMSG2_0(base, die, v1, v2, ...)                     base @@ _MSG(die, v1, v2, '')}
{#define _JIECUNIT_OPTMSG2_1(base, die, v1, v2, m)                       base @@ _MSG(die, v1, v2, m)}
