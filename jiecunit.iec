// These *_MSG macros are kept for backward compatibility. New code should
// pass the message as the optional last argument of the plain macro, e.g.
// EXPECT_EQ_INT(expected, actual, message).
{#define ASSERT_FALSE_MSG(condition, message)   _VALIDATE_BOOL_MSG(true, false, condition, message, _JIECUNIT_TEXT(@condition))}
{#define ASSERT_TRUE_MSG(condition, message)    _VALIDATE_BOOL_MSG(true, true, condition, message, _JIECUNIT_TEXT(@condition))}


{#define ASSERT_EQ_SINT_MSG(expected, actual, message)      _VALIDATE_EQ_INT32_MSG(true, expected, actual, message, _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
