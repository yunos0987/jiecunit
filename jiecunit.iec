// ---------------------------------------------------------------------- //
// Optional-message dispatchers (internal; do not use directly).
//
// Every public assertion macro takes an optional trailing message argument:
//   EXPECT_EQ_INT(expected, actual)            -> message is ''
//   EXPECT_EQ_INT(expected, actual, message)   -> message is used
//
// _JIECUNIT_OPTMSG<K>_N(n, base, ...) dispatches on the actual argument count n
// to base @@ _MSG(...), appending '' when the message is omitted. K is the
// number of value arguments the assertion takes (1: TRUE/FALSE,
// 2: EQ/NE/LT/LE/GE/GT, 3: NEAR/NEAR_REL). _JIECUNIT_OPTFAIL_N is the K=0
// counterpart used by FAIL/ADD_FAILURE, which take no value argument.
//
// A wrong argument count expands to a deliberate syntax error named
// JIECUNIT_ASSERTION_TAKES_<lo>_OR_<hi>_ARGUMENTS, so both `jiecc -c` and
// `jiecc --run` report it at the call site.
//
// Each dispatcher only defines buckets for n = 0..16. A call with more than
// 16 total arguments falls through to an undefined macro name instead of
// _JIECUNIT_BAD_ARGC_, so `jiecc -c` does not flag it (only `jiecc --run`
// reports UNDEFINED_SYMBOL). If a future assertion needs more arguments,
// raise this limit in all four dispatcher systems together.
//
// scripts/check_macro_expansion.py verifies that every one of the 290
// public assertion macros expands identically with and without this
// dispatch layer, so changes here must keep that check passing.
// ---------------------------------------------------------------------- //
{#define _JIECUNIT_BAD_ARGC_(lo, hi)                                     end_var JIECUNIT_ASSERTION_TAKES_ @@ lo @@ _OR_ @@ hi @@ _ARGUMENTS}

{#define _JIECUNIT_OPTMSG1_0(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_1(base, die, fixed_, v1)                      base @@ _MSG(die, fixed_, v1, '')}
{#define _JIECUNIT_OPTMSG1_2(base, die, fixed_, v1, m)                   base @@ _MSG(die, fixed_, v1, m)}
{#define _JIECUNIT_OPTMSG1_3(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_4(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_5(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_6(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_7(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_8(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_9(base, die, fixed_, ...)                     _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_10(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_11(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_12(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_13(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_14(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_15(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_16(base, die, fixed_, ...)                    _JIECUNIT_BAD_ARGC_(1, 2)}
{#define _JIECUNIT_OPTMSG1_N(n, base, die, fixed_, ...)                  _JIECUNIT_OPTMSG1_ @@ n(base, die, fixed_, __VA_ARGS__)}

{#define _JIECUNIT_OPTMSG2_0(base, die, ...)                             _JIECUNIT_BAD_ARGC_(2, 3)}
{#define _JIECUNIT_OPTMSG2_1(base, die, ...)                             _JIECUNIT_BAD_ARGC_(2, 3)}
{#define _JIECUNIT_OPTMSG2_2(base, die, v1, v2)                          base @@ _MSG(die, v1, v2, '')}
{#define _JIECUNIT_OPTMSG2_3(base, die, v1, v2, m)                       base @@ _MSG(die, v1, v2, m)}
{#define _JIECUNIT_OPTMSG2_4(base, die, ...)                             _JIECUNIT_BAD_ARGC_(2, 3)}
{#define _JIECUNIT_OPTMSG2_5(base, die, ...)                             _JIECUNIT_BAD_ARGC_(2, 3)}
