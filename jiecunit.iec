{#define _JIECUNIT_OPTMSG2_N(n, base, die, ...)                          _JIECUNIT_OPTMSG2_ @@ n(base, die, __VA_ARGS__)}

{#define _JIECUNIT_OPTMSG3_0(base, die, ...)                             _JIECUNIT_BAD_ARGC_(3, 4)}
