{#define ASSERT_GT_LINT(lval, rval, ...)                _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_INT64, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_INT32(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_INT32, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_INT64(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_INT64, true, lval, rval, __VA_ARGS__)}

{#define ASSERT_GT_USINT(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_UINT32, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_UINT(lval, rval, ...)                _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_UINT32, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_UDINT(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_UINT32, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_ULINT(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_UINT64, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_UINT32(lval, rval, ...)              _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_UINT32, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_UINT64(lval, rval, ...)              _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_UINT64, true, lval, rval, __VA_ARGS__)}

{#define ASSERT_GT_REAL(lval, rval, ...)                _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_DOUBLE, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_LREAL(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_DOUBLE, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_FLOAT(lval, rval, ...)               _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_DOUBLE, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_DOUBLE(lval, rval, ...)              _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_DOUBLE, true, lval, rval, __VA_ARGS__)}

{#define ASSERT_GT_TIME(lval, rval, ...)                _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_TIME, true, lval, rval, __VA_ARGS__)}

{#define ASSERT_GT_DATE(lval, rval, ...)                _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_DATE, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_TOD(lval, rval, ...)                 _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_TOD, true, lval, rval, __VA_ARGS__)}
{#define ASSERT_GT_DT(lval, rval, ...)                  _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_DT, true, lval, rval, __VA_ARGS__)}

{#define ASSERT_GT_STRING(lval, rval, ...)              _JIECUNIT_OPTMSG2_N(__VA_ARGC__, _VALIDATE_GT_STRING, true, lval, rval, __VA_ARGS__)}

{#define ASSERT_NEAR(val1, val2, abs_error, ...)        _JIECUNIT_OPTMSG3_N(__VA_ARGC__, _VALIDATE_NEAR, true, val1, val2, abs_error, __VA_ARGS__)}
{#define ASSERT_NEAR_REL(val1, val2, rel_error, ...)    _JIECUNIT_OPTMSG3_N(__VA_ARGC__, _VALIDATE_NEAR_REL, true, val1, val2, rel_error, __VA_ARGS__)}



{#define _JIEC_TESTNAMES_LIST_(...)
	var_global
		_JIECTESTNAMES_: array[MAX_TESTS] of string[TESTNAME_MAX_SIZE] := [_STRINGIFY_(__VA_ARGS__), (MAX_TESTS - __VA_ARGC__)('')];
		_JIECTEST_: JiecTest_t;
	end
	_JIECUNIT_DEFINE_TASKS(__VA_ARGS__)
}



// Test for a single-cycle test.
{#define TEST_S(test_name)
	program ${single-body:true$} ${__func__:TestName$} test_name
	_DECLARE_EXTERNAL_JIEC_TEST();
	${st$}
	if not _JIECTEST_.tmp_is_test_available then
		_JIECTEST_.tmp_is_test_available := JiecTest_activeTestname(_JIECTEST_) = @test_name;
	end_if;
	if (not JiecTest_isActive(_JIECTEST_)) or (JiecTest_activeTestname(_JIECTEST_) <> @test_name) then
		return;
	end_if;
	${end$}
}
{#define END_TEST_S
	${st$}
	EOT();
	${end$}
end}

// Test for the muiltiple-cycles test.
{#define TEST_M(test_name)
	program ${single-body:true$} ${__func__:TestName$} test_name
	_DECLARE_EXTERNAL_JIEC_TEST();
	${st$}
	if not _JIECTEST_.tmp_is_test_available then
		_JIECTEST_.tmp_is_test_available := JiecTest_activeTestname(_JIECTEST_) = @test_name;
	end_if;
	if (not JiecTest_isActive(_JIECTEST_)) or (JiecTest_activeTestname(_JIECTEST_) <> @test_name) then
		return;
	end_if;
	${end$}
}
{#define END_TEST_M
	${st$}
	${end$}
end}

// End of Test. Terminate the current test.
{#define EOT() JiecTest_deactivate(_JIECTEST_); return}

// Skip the current test. The test is reported as skipped, not as passed.
{#define SKIP_TEST(reason_) JiecTest_skip(self:=_JIECTEST_, reason:=reason_); EOT()}

(*
 * The current cycle number.
 *  Info.: In the unit test for the single-cycle test, the result is always 0.
 *)
{#define CURRENT_CYCLE() JiecTest_currentCycle(_JIECTEST_)}

// Record a failure without aborting the test.
{#define ADD_FAILURE(...)                       _JIECUNIT_OPTFAIL_N(__VA_ARGC__, false, __VA_ARGS__)}
{#define ADD_FAILURE_MSG(message)  _VALIDATE_FAILURE_(false, message)}
// Record a failure and abort the test immediately.
{#define FAIL(...)                              _JIECUNIT_OPTFAIL_N(__VA_ARGC__, true, __VA_ARGS__)}
{#define FAIL_MSG(message)         _VALIDATE_FAILURE_(true, message)}

{#endif}
