// ---------------------------------------------------------------------- //
// Optional-message dispatchers (internal; do not use directly).
//
// Every public assertion macro declares its required arguments by name and
// takes an optional trailing message argument through a variadic tail:
//   EXPECT_EQ_INT(expected, actual)            -> message is ''
//   EXPECT_EQ_INT(expected, actual, message)   -> message is used
//   EXPECT_EQ_INT(1)                           -> too few required args
//   EXPECT_EQ_INT(1, 2, 3, 4)                  -> too many total args
//
// _JIECUNIT_OPTMSG_N(n, lo, hi, ...) expands to the message argument only,
// so one dispatcher serves every assertion whatever number of required
// arguments it takes. It dispatches on n = __VA_ARGC__, the number of
// arguments AFTER the required ones: '' when n is 0 (message omitted), the
// message itself when n is 1, and _JIECUNIT_BAD_ARGC_(lo, hi) when n is 2
// or more. lo/hi are the TOTAL argument counts the public macro accepts
// (required args, and required args + message), which is not the same
// quantity as n: 0/1 for FAIL/ADD_FAILURE, 1/2 for TRUE/FALSE, 2/3 for
// EQ/NE/LT/LE/GE/GT, 3/4 for NEAR/NEAR_REL.
//
// Every public macro follows this template:
//   #define NAME(<required args>, ...)
//       <base>_MSG(<die>, [<fixed>,] <required args>,
//                  _JIECUNIT_OPTMSG_N(__VA_ARGC__, <lo>, <hi>, __VA_ARGS__))
// (written inside the usual preprocessor directive braces, i.e. wrapped as
// open-brace + the lines above + close-brace.) <fixed> is only present for
// TRUE/FALSE: a BOOL literal the public macro itself bakes in (true for
// EXPECT_TRUE, false for EXPECT_FALSE). FAIL/ADD_FAILURE use
// _VALIDATE_FAILURE_(<die>, <message>) in place of <base>_MSG(...).
//
// Only bucket _1 receives the message as a named parameter; every other
// bucket keeps a trailing `...` instead, for two different reasons. Bucket
// _0 needs it because when the message is omitted, __VA_ARGS__ at the call
// site expands to nothing and leaves one empty trailing argument that only
// a variadic parameter can absorb. Buckets _2..16 need it because they each
// receive n extra trailing arguments whose content is discarded (the call
// is already wrong), so `...` absorbs however many of them arrived instead
// of naming n separate parameters per bucket.
//
// A wrong TOTAL argument count is reported one of three ways, depending on
// which side of the required arguments the mistake falls on:
//   - Too many trailing arguments (n >= 2): the message argument expands to
//     the deliberate syntax error JIECUNIT_ASSERTION_TAKES_<lo>_OR_<hi>_ARGUMENTS,
//     which both `jiecc -c` and `jiecc --run` report at the call site.
//   - Too few required arguments (e.g. EXPECT_EQ_INT(1)): the public macro's
//     named required parameters make the preprocessor itself refuse the
//     call, reporting `PP34: Argument count mismatch` at the call site
//     before this dispatch layer ever runs. `jiecc -c` still exits 0 in
//     this case and writes an XML file that contains no POUs at all, so the
//     exit code alone does not reveal the failure; scripts/run_tests.py
//     detects it by also scanning the output for `error:` lines.
//   - No arguments at all (e.g. EXPECT_FALSE()): expands with one empty
//     argument (`actual:=,`), which `jiecc -c` rejects as `','; INVALID_SYNTAX`
//     at the call site.
//
// The dispatcher only defines buckets for the 0..16 extra trailing
// arguments beyond the required ones. A call with more extra arguments than
// that falls through to an undefined macro name instead of
// _JIECUNIT_BAD_ARGC_, so `jiecc -c` does not flag it (only `jiecc --run`
// reports UNDEFINED_SYMBOL). If this limit is raised, update the boundary
// probes in scripts/check_macro_expansion.py's _EXCESS_CASES to match.
//
// FAIL/ADD_FAILURE take no required value argument, so their public macros
// keep the plain `(...)` signature instead of a named parameter.
//
// scripts/check_macro_expansion.py verifies that every one of the 290
// public assertion macros expands identically with and without this
// dispatch layer, so changes here must keep that check passing.
// ---------------------------------------------------------------------- //
{#define _JIECUNIT_BAD_ARGC_(lo, hi)                                     end_var JIECUNIT_ASSERTION_TAKES_ @@ lo @@ _OR_ @@ hi @@ _ARGUMENTS}

{#define _JIECUNIT_OPTMSG_0(lo, hi, ...)                                 ''}
{#define _JIECUNIT_OPTMSG_1(lo, hi, m)                                   m}
{#define _JIECUNIT_OPTMSG_2(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_3(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_4(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_5(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_6(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_7(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_8(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_9(lo, hi, ...)                                 _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_10(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_11(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_12(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_13(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_14(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_15(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_16(lo, hi, ...)                                _JIECUNIT_BAD_ARGC_(lo, hi)}
{#define _JIECUNIT_OPTMSG_N(n, lo, hi, ...)                              _JIECUNIT_OPTMSG_ @@ n(lo, hi, __VA_ARGS__)}


// These *_MSG macros are kept for backward compatibility. New code should
// pass the message as the optional last argument of the plain macro, e.g.
// EXPECT_EQ_INT(expected, actual, message).
{#define EXPECT_FALSE_MSG(condition, message)   _VALIDATE_EQ_BOOL_MSG(false, false, condition, message)}
{#define EXPECT_TRUE_MSG(condition, message)    _VALIDATE_EQ_BOOL_MSG(false, true, condition, message)}


{#define EXPECT_EQ_SINT_MSG(expected, actual, message)      _VALIDATE_EQ_INT32_MSG(false, expected, actual, message)}
{#define EXPECT_EQ_INT_MSG(expected, actual, message)       _VALIDATE_EQ_INT32_MSG(false, expected, actual, message)}
