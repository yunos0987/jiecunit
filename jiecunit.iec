// Floating-point equality within 4 ULPs (units in the last place), like
// EXPECT_DOUBLE_EQ / EXPECT_FLOAT_EQ of Google Test. *_DOUBLE_EQ compares
// LREAL values, *_FLOAT_EQ compares REAL values with the precision of REAL.
// A NaN is never equal; an infinity is equal only to the same infinity.
{#define EXPECT_DOUBLE_EQ(expected, actual, ...)        _VALIDATE_DOUBLE_EQ_MSG(false, expected, actual, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 2, 3, __VA_ARGS__), _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
{#define EXPECT_FLOAT_EQ(expected, actual, ...)         _VALIDATE_FLOAT_EQ_MSG(false, expected, actual, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 2, 3, __VA_ARGS__), _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
{#define ASSERT_DOUBLE_EQ(expected, actual, ...)        _VALIDATE_DOUBLE_EQ_MSG(true, expected, actual, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 2, 3, __VA_ARGS__), _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}
{#define ASSERT_FLOAT_EQ(expected, actual, ...)         _VALIDATE_FLOAT_EQ_MSG(true, expected, actual, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 2, 3, __VA_ARGS__), _JIECUNIT_TEXT(@expected), _JIECUNIT_TEXT(@actual))}



// The number of TEST_S/TEST_M definitions is counted with the named counter
// _jiecunit_tests (the __assert in the test headers only advances it), and
// _JIEC_TESTNAMES_LIST_ compares it with the number of listed names, so that
// a test missing from the list stops the preprocessor instead of silently not
// running. The list must therefore come after all test definitions, and be
// expanded only once (the counter is not reset). Only the numbers are
// compared: a name listed twice is reported when the tests are registered
// (jier: DUPLICATE_SYMBOL; PLC: "Fatal error: ... already registered"), and a
// misspelled name is reported as an undefined program (jier) or as "was not
// found in active tasks" (PLC). Define JIECUNIT_NO_TEST_COUNT_CHECK to turn
// the check off.
{#define _JIECUNIT_COUNT_TEST() __assert(__counter(_jiecunit_tests) >= 0, '')}
{#ifndef JIECUNIT_NO_TEST_COUNT_CHECK}
	{#define _JIECUNIT_CHECK_TEST_COUNT(n) __assert(__counter_peek(_jiecunit_tests) = n, 'JiecUnit: the number of TEST_S/TEST_M definitions differs from the number of names in _JIEC_TESTNAMES_LIST_. List every test exactly once (look for a missing, removed or extra name), and place DEFINE_CONFIGURATION(_JIEC_TESTNAMES_LIST_(...)) once, after all test definitions (or define JIECUNIT_NO_TEST_COUNT_CHECK to turn this check off).')}
{#else}
	{#define _JIECUNIT_CHECK_TEST_COUNT(n)}
{#endif}

{#define _JIEC_TESTNAMES_LIST_(...)
	_JIECUNIT_CHECK_TEST_COUNT(__VA_ARGC__)
	var_global
		_JIECTESTNAMES_: array[MAX_TESTS] of string[TESTNAME_MAX_SIZE] := [_STRINGIFY_(__VA_ARGS__), (MAX_TESTS - __VA_ARGC__)('')];
		_JIECTEST_: JiecTest_t;
	end
	_JIECUNIT_DEFINE_TASKS(__VA_ARGS__)
}



// The header of a test program (internal). program_name is the name of the
// PROGRAM (also the name in _JIEC_TESTNAMES_LIST_), display_name the name
// shown in the results, single_ true for a single-cycle test.
{#define _JIECUNIT_TEST_HEADER_(program_name, display_name_, single_)
	_JIECUNIT_COUNT_TEST()
	program ${single-body:true$} ${__func__:TestName$} program_name
	_DECLARE_EXTERNAL_JIEC_TEST();
	var
		jiecunit_in_helper: bool := false;
	end
	if (not JiecTest_isActive(_JIECTEST_)) or (JiecTest_activeTestname(_JIECTEST_) <> @program_name) then
		return;
	end_if;
	JiecTest_enterTest(self:=_JIECTEST_, single_cycle:=single_, file:=__FILE__, line:=__LINE__, display_name:=display_name_);
}

// The header of a test program with a fixture (internal). The program has the
// variable `fixture` of type fixture_type. In the first run of the test,
// fixture is reset to its initial value, the TearDown is requested and
// <fixture_type>_SetUp(fixture) is called; if the SetUp fails fatally, skips
// or ends the test, the body does not run. After the test has ended,
// JiecUnitMain waits a cycle in which <fixture_type>_TearDown(fixture) runs,
// whatever way the test ended (EOT, ASSERT, SKIP_TEST, the cycle limit).
{#define _JIECUNIT_TEST_F_HEADER_(fixture_type, program_name, display_name_, single_)
	_JIECUNIT_COUNT_TEST()
	program ${single-body:true$} ${__func__:TestName$} program_name
	_DECLARE_EXTERNAL_JIEC_TEST();
	var
		jiecunit_in_helper: bool := false;
		fixture: fixture_type;
		jiecunit_fixture_init: fixture_type;
	end
	if JiecTest_isTearDownPending(self:=_JIECTEST_, test_name:=@program_name) then
		fixture_type @@ _TearDown(fixture);
		JiecTest_endTearDown(_JIECTEST_);
		return;
	end_if;
	if (not JiecTest_isActive(_JIECTEST_)) or (JiecTest_activeTestname(_JIECTEST_) <> @program_name) then
		return;
	end_if;
	if JiecTest_enterTest(self:=_JIECTEST_, single_cycle:=single_, file:=__FILE__, line:=__LINE__, display_name:=display_name_) then
		fixture := jiecunit_fixture_init;
		JiecTest_requestTearDown(_JIECTEST_);
		fixture_type @@ _SetUp(fixture);
		if (not JiecTest_isActive(_JIECTEST_)) or JiecTest_hasFatalFailure(_JIECTEST_) then
			JiecTest_deactivate(_JIECTEST_);
			return;
		end_if;
	end_if;
}

// Stringify an argument after its macro parameters are replaced (internal):
// _JIECUNIT_DISPLAY_NAME_(suite.name) gives 'suite.name'.
{#define _JIECUNIT_DISPLAY_NAME_(dotted_name) @dotted_name}

// Test for a single-cycle test: TEST_S(name), or TEST_S(suite, name) for a
// test in a suite. The program of TEST_S(suite, name) is suite_name (list
// that name in _JIEC_TESTNAMES_LIST_), and the results show suite.name.
// The test ends at END_TEST_S, or at the end of its first cycle if the body
// returns before END_TEST_S.
{#define TEST_S(...) _JIECUNIT_TEST_S_N(__VA_ARGC__, __VA_ARGS__)}
{#define _JIECUNIT_TEST_S_N(n, ...) _JIECUNIT_TEST_S_ @@ n(__VA_ARGS__)}
{#define _JIECUNIT_TEST_S_1(test_name) _JIECUNIT_TEST_HEADER_(test_name, '', true)}
{#define _JIECUNIT_TEST_S_2(suite, test_name) _JIECUNIT_TEST_HEADER_(suite @@ _ @@ test_name, _JIECUNIT_DISPLAY_NAME_(suite.test_name), true)}
{#define END_TEST_S
	EOT();
end}

// Test for the multiple-cycles test: TEST_M(name) or TEST_M(suite, name),
// named like TEST_S. The test runs once per cycle until it calls EOT(), or
// fails when it reaches the maximum number of cycles
// (JIECUNIT_MAX_CYCLES_PER_TEST, or SET_TEST_MAX_CYCLES(n) in the test).
{#define TEST_M(...) _JIECUNIT_TEST_M_N(__VA_ARGC__, __VA_ARGS__)}
{#define _JIECUNIT_TEST_M_N(n, ...) _JIECUNIT_TEST_M_ @@ n(__VA_ARGS__)}
{#define _JIECUNIT_TEST_M_1(test_name) _JIECUNIT_TEST_HEADER_(test_name, '', false)}
{#define _JIECUNIT_TEST_M_2(suite, test_name) _JIECUNIT_TEST_HEADER_(suite @@ _ @@ test_name, _JIECUNIT_DISPLAY_NAME_(suite.test_name), false)}
{#define END_TEST_M
end}

// Tests with a fixture, like TEST_F of Google Test: TEST_F_S(F, name) is a
// single-cycle test and TEST_F_M(F, name) a multiple-cycles test of the suite
// F (end them with END_TEST_S / END_TEST_M). Define for the fixture:
//   type F: struct ... end end                    // the data of the fixture
//   function F_SetUp     var_in_out fixture: F; end  JIECUNIT_DECLARE_HELPER(); ... end
//   function F_TearDown  var_in_out fixture: F; end  JIECUNIT_DECLARE_HELPER(); ... end
// The test uses the variable `fixture`, which every run of the test starts
// from the initial value of F. SetUp runs before the body, TearDown after the
// test has ended, also when it failed, was skipped or reached the cycle limit.
{#define TEST_F_S(fixture_type, test_name) _JIECUNIT_TEST_F_HEADER_(fixture_type, fixture_type @@ _ @@ test_name, _JIECUNIT_DISPLAY_NAME_(fixture_type.test_name), true)}
{#define TEST_F_M(fixture_type, test_name) _JIECUNIT_TEST_F_HEADER_(fixture_type, fixture_type @@ _ @@ test_name, _JIECUNIT_DISPLAY_NAME_(fixture_type.test_name), false)}

// End of Test. Terminate the current test.
{#define EOT() JiecTest_deactivate(_JIECTEST_); return}

// Skip the current test. The test is reported as skipped, not as passed.
{#define SKIP_TEST(reason_) JiecTest_skip(self:=_JIECTEST_, reason:=reason_); EOT()}

// Set the maximum number of cycles of the current test: the test fails if it
// is still running after it has run max_cycles cycles. 0 or a negative value
// means no limit. The value applies to this test only; the next test starts
// with JIECUNIT_MAX_CYCLES_PER_TEST again.
{#define SET_TEST_MAX_CYCLES(max_cycles_) JiecTest_setMaxCycles(self:=_JIECTEST_, max_cycles:=max_cycles_)}

(*
 * The current cycle number.
 *  Info.: In the unit test for the single-cycle test, the result is always 0.
 *)
{#define CURRENT_CYCLE() JiecTest_currentCycle(_JIECTEST_)}

// ------------------------------------------------------------------------
// Fatal failures in helpers, and checking failures (like Google Test).
// ------------------------------------------------------------------------

// Declare a helper POU (FUNCTION, FUNCTION_BLOCK or PROGRAM) that uses
// assertions: write it among the declarations of the POU. A fatal failure
// (ASSERT_*, FAIL) in a helper returns from the helper only and the test goes
// on, as in Google Test; HAS_FATAL_FAILURE() tells it, and
// ASSERT_NO_FATAL_FAILURE(helper(...)) stops the test after it.
{#define JIECUNIT_DECLARE_HELPER()
	_DECLARE_EXTERNAL_JIEC_TEST();
	var
		jiecunit_in_helper: bool := true;
	end}

// Whether the current test has had a fatal / non-fatal / any failure.
{#define HAS_FATAL_FAILURE() JiecTest_hasFatalFailure(_JIECTEST_)}
{#define HAS_NONFATAL_FAILURE() JiecTest_hasNonfatalFailure(_JIECTEST_)}
{#define HAS_FAILURE() (JiecTest_hasFatalFailure(_JIECTEST_) or JiecTest_hasNonfatalFailure(_JIECTEST_))}

// Run a statement (usually the call of a helper) and fail if it generates a
// new fatal failure: ASSERT_ stops the test, EXPECT_ goes on.
{#define _JIECUNIT_NO_FATAL_FAILURE_(die_, statement_, message_, statement_text_)
	JiecTest_beginNoFatalFailure(self:=_JIECTEST_, file:=__FILE__, line:=__LINE__);
	statement_;
	if JiecTest_endNoFatalFailure(self:=_JIECTEST_, statement_text:=statement_text_, message:=message_, die:=die_, file:=__FILE__, line:=__LINE__) then
		_ON_FAILED_ACTION(die_);
	end_if}
{#define ASSERT_NO_FATAL_FAILURE(statement, ...)        _JIECUNIT_NO_FATAL_FAILURE_(true, statement, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 1, 2, __VA_ARGS__), _JIECUNIT_TEXT(@statement))}
{#define EXPECT_NO_FATAL_FAILURE(statement, ...)        _JIECUNIT_NO_FATAL_FAILURE_(false, statement, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 1, 2, __VA_ARGS__), _JIECUNIT_TEXT(@statement))}

// Check that a statement generates exactly one fatal (EXPECT_FATAL_FAILURE)
// or non-fatal (EXPECT_NONFATAL_FAILURE) failure, one of whose lines contains
// substr. The checked failure is neither printed nor counted. For tests of
// assertions and helpers (gtest-spi.h of Google Test). The statement of
// EXPECT_FATAL_FAILURE must be the call of a helper: an ASSERT written
// directly in it would return from the test.
{#define _JIECUNIT_EXPECT_FAILURE_(fatal_, statement_, substr_, statement_text_)
	JiecTest_beginCapture(self:=_JIECTEST_, substr:=substr_, file:=__FILE__, line:=__LINE__);
	statement_;
	JiecTest_endCapture(self:=_JIECTEST_, fatal:=fatal_, statement_text:=statement_text_, file:=__FILE__, line:=__LINE__)}
{#define EXPECT_FATAL_FAILURE(statement, substr)        _JIECUNIT_EXPECT_FAILURE_(true, statement, substr, _JIECUNIT_TEXT(@statement))}
{#define EXPECT_NONFATAL_FAILURE(statement, substr)     _JIECUNIT_EXPECT_FAILURE_(false, statement, substr, _JIECUNIT_TEXT(@statement))}

// Record a failure without aborting the test.
{#define ADD_FAILURE(...)                       _VALIDATE_FAILURE_(false, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 0, 1, __VA_ARGS__))}
{#define ADD_FAILURE_MSG(message)  _VALIDATE_FAILURE_(false, message)}
// Record a failure and abort the test immediately.
{#define FAIL(...)                              _VALIDATE_FAILURE_(true, _JIECUNIT_OPTMSG_N(__VA_ARGC__, 0, 1, __VA_ARGS__))}
{#define FAIL_MSG(message)         _VALIDATE_FAILURE_(true, message)}

{#endif}
