{#ifndef __JIECTEST_VALIDATE_NE_IEC__}
{#define __JIECTEST_VALIDATE_NE_IEC__}

{#include "jiectest_validate_common.iec"}

// Defines JiecTest_validateNE_<DATATYPE> (see jiectest_validate_common.iec).
{#define _JIECTEST_DEFINE_VALIDATE_NE_(DATATYPE, TYPE, TOSTR)
(*${doc Validate that the expected value is not equal to the actual value.$n$
@inout self The JiecTest_t structure.$n$
@input expected The expected value.$n$
@input actual The actual value.$n$
@input message The failure message.$n$
@input die Whether to abort the test on failure.$n$
@input file The source file name.$n$
@input line The line number.$n$
@return True if the values are not equal, false otherwise.$n$
$}*)$n$
function JiecTest_validateNE_@@DATATYPE: bool$n$
	_PROLOGUE_OF_FUNCTION_()$n$
	_DECLARE_CONSOLE_IN_POU_()$n$
	var_in_out self: JiecTest_t; end$n$
	var_input$n$
		(*${doc The expected value.$}*)$n$
		expected: TYPE;$n$
		(*${doc The actual value.$}*)$n$
		actual: TYPE;$n$
		(*${doc The failure message.$}*)$n$
		message: string[128];$n$
		(*${doc Whether to abort the test on failure.$}*)$n$
		die: bool := true;$n$
		(*${doc The source file name.$}*)$n$
		file: string[FILENAME_MAX_SIZE];$n$
		(*${doc The line number.$}*)$n$
		line: dint;$n$
	end$n$
	JiecTest_validateNE_@@DATATYPE := expected <> actual;$n$
	if JiecTest_validateNE_@@DATATYPE then$n$
		return;$n$
	end_if;$n$
$n$
	puts(jiec_concat('Expected NOT: ', TOSTR(expected)));$n$
	puts(jiec_concat('Actual: ', TOSTR(actual)));$n$
$n$
	JiecTest_failure(self:=self, message:=message, die:=die, file:=file, line:=line);$n$
end$n$
}

_JIECTEST_FOR_EQ_TYPES_(_JIECTEST_DEFINE_VALIDATE_NE_)

{#endif}
