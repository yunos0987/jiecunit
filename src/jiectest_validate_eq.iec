{#ifndef __JIECTEST_VALIDATE_EQ_IEC__}
{#define __JIECTEST_VALIDATE_EQ_IEC__}

{#include "jiectest_validate_common.iec"}

// Defines JiecTest_validateEQ_<DATATYPE> (see jiectest_validate_common.iec).
{#define _JIECTEST_DEFINE_VALIDATE_EQ_(DATATYPE, TYPE, TOSTR)
(*${doc Validate that the expected value equals the actual value.$n$
@inout self The JiecTest_t structure.$n$
@input expected The expected value.$n$
@input actual The actual value.$n$
@input message The failure message.$n$
@input die Whether to abort the test on failure.$n$
@input file The source file name.$n$
@input line The line number.$n$
@input expected_text The source text of the first value (optional).$n$
@input actual_text The source text of the second value (optional).$n$
@return True if the values are equal, false otherwise.$n$
$}*)$n$
function JiecTest_validateEQ_@@DATATYPE: bool$n$
	_PROLOGUE_OF_FUNCTION_()$n$
	var_in_out self: JiecTest_t; end$n$
	var_input$n$
		(*${doc The expected value.$}*)$n$
		expected: TYPE;$n$
		(*${doc The actual value.$}*)$n$
		actual: TYPE;$n$
		(*${doc The failure message.$}*)$n$
		message: string[STRING_MAX_SIZE];$n$
		(*${doc Whether to abort the test on failure.$}*)$n$
		die: bool := true;$n$
		(*${doc The source file name.$}*)$n$
		file: string[FILENAME_MAX_SIZE];$n$
		(*${doc The line number.$}*)$n$
		line: dint;$n$
		(*${doc The source text of the first value (optional).$}*)$n$
		expected_text: string[EXPRESSION_MAX_SIZE] := '';$n$
		(*${doc The source text of the second value (optional).$}*)$n$
		actual_text: string[EXPRESSION_MAX_SIZE] := '';$n$
	end$n$
	JiecTest_validateEQ_@@DATATYPE := expected = actual;$n$
	if JiecTest_validateEQ_@@DATATYPE then$n$
		return;$n$
	end_if;$n$
$n$
	JiecTest_beginFailure(self:=self, file:=file, line:=line);$n$
	JiecTest_print(self, 'Expected equality of these values:');$n$
	JiecTest_printValue(self:=self, expr_text:=expected_text, value:=TOSTR(expected));$n$
	JiecTest_printValue(self:=self, expr_text:=actual_text, value:=TOSTR(actual));$n$
	JiecTest_endFailure(self:=self, message:=message, die:=die);$n$
end$n$
}

_JIECTEST_FOR_EQ_TYPES_(_JIECTEST_DEFINE_VALIDATE_EQ_)

{#endif}
