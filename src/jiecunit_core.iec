{#endif}
{#define _VALIDATE_EQ_DOUBLE_MSG(die, expected, actual, message, text1, text2)    _VALIDATE_EQ_DATATYPE(DOUBLE, die, expected, actual, message, text1, text2)}
{#define _VALIDATE_EQ_FLOAT_MSG(die, expected, actual, message, text1, text2)     _VALIDATE_EQ_DATATYPE(FLOAT, die, expected, actual, message, text1, text2)}
