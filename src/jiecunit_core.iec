// ------------------------ Define low level macros ------------------------ //

{#define _ON_FAILED_ACTION(die)
	if die then
		JiecTest_deactivate(_JIECTEST_);
		return;
	end_if
}

{#define _VALIDATE_EQ_DATATYPE(DATATYPE, die_, expected_, actual_, message_, expected_text_, actual_text_)
	if not JiecTest_validateEQ_ @@ DATATYPE(self:=_JIECTEST_, expected:=expected_, actual:=actual_, message:=message_, die:=die_, file:=__FILE__, line:=__LINE__, expected_text:=expected_text_, actual_text:=actual_text_) then
		_ON_FAILED_ACTION(die_);
	end_if}
{#define _VALIDATE_EQ_INT32_MSG(die, expected, actual, message, t1, t2)     _VALIDATE_EQ_DATATYPE(INT32, die, expected, actual, message, t1, t2)}
{#if not (_KEYENCE or _MITSUBISHI)}
{#define _VALIDATE_EQ_INT64_MSG(die, expected, actual, message, t1, t2)     _VALIDATE_EQ_DATATYPE(INT64, die, expected, actual, message, t1, t2)}
{#endif}
{#define _VALIDATE_EQ_UINT32_MSG(die, expected, actual, message, t1, t2)    _VALIDATE_EQ_DATATYPE(UINT32, die, expected, actual, message, t1, t2)}
{#if not (_KEYENCE or _MITSUBISHI)}
