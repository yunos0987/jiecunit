// ------------------------ Define low level macros ------------------------ //

// After a failure: a fatal one (die) returns from the POU of the assertion.
// JiecTest_abort ends the test only in the body of the test, not in a helper
// (jiecunit_in_helper is declared by the TEST_* headers as false and by
// JIECUNIT_DECLARE_HELPER as true), as in Google Test.
// An error that jiecunit_in_helper is not declared means that an assertion is
// used outside a test: declare the POU with JIECUNIT_DECLARE_HELPER().
{#define _ON_FAILED_ACTION(die)
	if die then
		JiecTest_abort(self:=_JIECTEST_, in_helper:=jiecunit_in_helper);
		return;
	end_if
}

{#define _VALIDATE_EQ_DATATYPE(DATATYPE, die_, expected_, actual_, message_, expected_text_, actual_text_)
	if not JiecTest_validateEQ_ @@ DATATYPE(self:=_JIECTEST_, expected:=expected_, actual:=actual_, message:=message_, die:=die_, file:=__FILE__, line:=__LINE__, expected_text:=expected_text_, actual_text:=actual_text_) then
		_ON_FAILED_ACTION(die_);
	end_if}
{#define _VALIDATE_EQ_INT32_MSG(die, expected, actual, message, text1, text2)     _VALIDATE_EQ_DATATYPE(INT32, die, expected, actual, message, text1, text2)}
{#if not (_KEYENCE or _MITSUBISHI)}
{#define _VALIDATE_EQ_INT64_MSG(die, expected, actual, message, text1, text2)     _VALIDATE_EQ_DATATYPE(INT64, die, expected, actual, message, text1, text2)}
{#else}
{#define _VALIDATE_EQ_INT64_MSG(die, expected, actual, message, text1, text2)    __error('EXPECT_EQ_LINT/INT64 / ASSERT_EQ_LINT/INT64 (and the array forms) are not supported on this target')}
{#endif}
{#define _VALIDATE_EQ_UINT32_MSG(die, expected, actual, message, text1, text2)    _VALIDATE_EQ_DATATYPE(UINT32, die, expected, actual, message, text1, text2)}
{#if not (_KEYENCE or _MITSUBISHI)}
