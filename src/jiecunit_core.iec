		_ON_FAILED_ACTION(die_);
	end_if}

// Compare two arrays element by element from index 0 to n - 1 and report the
// first element that differs with the EQ validator of the element type
// (BASE is its _VALIDATE_EQ_<DATATYPE>_MSG macro). The loop variable
// jiecunit_loop_index is declared by the TEST_* headers and by
// JIECUNIT_DECLARE_HELPER. (ST does not short-circuit `and`, so the loop
// exits instead of testing the index and the elements in one condition.)
{#define _VALIDATE_EQ_ARRAY_(BASE, die_, expected_, actual_, n_, message_, expected_text_, actual_text_)
	jiecunit_loop_index := 0;
	while jiecunit_loop_index < (n_) do
		if expected_[jiecunit_loop_index] <> actual_[jiecunit_loop_index] then
			exit;
		end_if;
		jiecunit_loop_index := jiecunit_loop_index + 1;
	end_while;
	if jiecunit_loop_index < (n_) then
		BASE(die_, expected_[jiecunit_loop_index], actual_[jiecunit_loop_index], JiecTest_arrayMessage(index:=jiecunit_loop_index, message:=message_), JiecTest_indexedText(text:=expected_text_, index:=jiecunit_loop_index), JiecTest_indexedText(text:=actual_text_, index:=jiecunit_loop_index));
	end_if}

{#define _VALIDATE_STR_CONTAINS_MSG(die_, haystack_, needle_, message_, haystack_text_, needle_text_)
	if not JiecTest_validateSTR_CONTAINS(self:=_JIECTEST_, haystack:=haystack_, needle:=needle_, message:=message_, die:=die_, file:=__FILE__, line:=__LINE__, haystack_text:=haystack_text_, needle_text:=needle_text_) then
		_ON_FAILED_ACTION(die_);
	end_if}

{#define _VALIDATE_NEAR_MSG(die, val1, val2, abs_error, message, text1, text2, text3)    _VALIDATE_NEAR_DATATYPE(DOUBLE, die, val1, val2, abs_error, message, text1, text2, text3)}

{#define _VALIDATE_NEAR_REL_(die_, val1_, val2_, rel_error_, message_, val1_text_, val2_text_, rel_error_text_)
	if not JiecTest_validateNEARREL(self:=_JIECTEST_, val1:=val1_, val2:=val2_, rel_error:=rel_error_, message:=message_, die:=die_, file:=__FILE__, line:=__LINE__, val1_text:=val1_text_, val2_text:=val2_text_, rel_error_text:=rel_error_text_) then
		_ON_FAILED_ACTION(die_);
	end_if}

{#define _VALIDATE_BOOL_MSG(die_, expected_, condition_, message_, condition_text_)
	if not JiecTest_validateBOOL(self:=_JIECTEST_, expected:=expected_, condition:=condition_, message:=message_, die:=die_, file:=__FILE__, line:=__LINE__, condition_text:=condition_text_) then
		_ON_FAILED_ACTION(die_);
	end_if}
{#define _VALIDATE_NEAR_REL_MSG(die, val1, val2, rel_error, message, text1, text2, text3)   _VALIDATE_NEAR_REL_(die, val1, val2, rel_error, message, text1, text2, text3)}

{#define _VALIDATE_FAILURE_(die_, message_)
	JiecTest_beginFailure(self:=_JIECTEST_, file:=__FILE__, line:=__LINE__);
	JiecTest_print(_JIECTEST_, 'Failed');
	JiecTest_endFailure(self:=_JIECTEST_, message:=message_, die:=die_);
	_ON_FAILED_ACTION(die_)}

{#define _JIECTEST_ g_jiectest}
{#define _JIECTESTNAMES_ g_jiectestnames}
// The result of the run (JiecUnitResult_t) and the request to run the tests
// again (BOOL), for the PLC tools: set g_jiecunit_rerun to true after the run
// has finished to run every test again.
{#define _JIECUNIT_RESULT_ g_jiecunit_result}
{#define _JIECUNIT_RERUN_ g_jiecunit_rerun}

{#if not (_KEYENCE or _MITSUBISHI)}
	{#define _DECLARE_EXTERNAL_JIEC_TESTNAMES() var_external _JIECTESTNAMES_: array[MAX_TESTS] of string[TESTNAME_MAX_SIZE]; end}
	{#define _DECLARE_EXTERNAL_JIEC_TEST() var_external _JIECTEST_: JiecTest_t; end}
	{#define DECLARE_EXTERNAL_JIECUNIT_RESULT() var_external _JIECUNIT_RESULT_: JiecUnitResult_t; _JIECUNIT_RERUN_: bool; end}
{#else}
	{#define _DECLARE_EXTERNAL_JIEC_TESTNAMES() }
	{#define _DECLARE_EXTERNAL_JIEC_TEST() }
	{#define DECLARE_EXTERNAL_JIECUNIT_RESULT() }
{#endif}

// Clock for the elapsed time of the tests.
//   _JIECUNIT_HAS_CLOCK      true if the target has a free-running counter.
//   _JIECUNIT_CLOCK_T        the type of the counter.
//   _JIECUNIT_CLOCK_NOW()    the current value of the counter.
//   _JIECUNIT_CLOCK_DIFF_US(later, earlier)
//                            the microseconds from earlier to later as udint. The
//                            difference is taken in the type of the counter
//                            first, so that it stays right when the counter
//                            wraps around.
// Both counters count in units of 100 ns, so 10 counts are 1 us.
{#if _OMRON}
	{#define _JIECUNIT_HAS_CLOCK true}
	{#define _JIECUNIT_CLOCK_T ulint}
	{#define _JIECUNIT_CLOCK_NOW() Get100nsCnt()}
	{#define _JIECUNIT_CLOCK_DIFF_US(later, earlier) ulint_to_udint(((later) - (earlier)) / 10)}
{#elif _KEYENCE}
	{#define _JIECUNIT_HAS_CLOCK true}
	{#define _JIECUNIT_CLOCK_T udint}
	{#define _JIECUNIT_CLOCK_NOW() _FreeRunCounter100ns}
	{#define _JIECUNIT_CLOCK_DIFF_US(later, earlier) (((later) - (earlier)) / 10)}
{#else}
	// No clock: the elapsed time is shown as "(n/a)".
	{#define _JIECUNIT_HAS_CLOCK false}
	{#define _JIECUNIT_CLOCK_T udint}
	{#define _JIECUNIT_CLOCK_NOW() 0}
	{#define _JIECUNIT_CLOCK_DIFF_US(later, earlier) 0}
{#endif}

// The elapsed-time suffix of the result lines: "(123us)", or "(n/a)" when the
// target has no clock.
{#if _JIECUNIT_HAS_CLOCK}
	{#define _JIECUNIT_ELAPSED_TEXT(us) jiec_concat('(', udint_to_string(us), 'us)')}
{#else}
	{#define _JIECUNIT_ELAPSED_TEXT(us) '(n/a)'}
{#endif}

(*{doc The main program for running the tests.
Assign it and every test program to the same task, with JiecUnitMain first.
JiecUnitMain also works as the last program of the task. A test program that
runs twice in one cycle of JiecUnitMain (in another task, or before and after
JiecUnitMain) or not at all is reported as an error.}*)
program {__func__:this_name} JiecUnitMain
	{#define _initialize()          JiecTest_initialize(_JIECTEST_)}
	{#define _register(testname)    JiecTest_register(_JIECTEST_, testname)}
	{#define _active_test_index()   JiecTest_activeTestIndex(_JIECTEST_)}
	{#define _active_testname()     JiecTest_activeTestname(_JIECTEST_)}
	{#define _display_name()        JiecTest_activeDisplayName(_JIECTEST_)}
	{#define _num_of_tests()        _JIECTEST_.num_of_tests}
	{#define _num_of_failures()     _JIECTEST_.num_of_failures}
	{#define _is_active()           JiecTest_isActive(_JIECTEST_)}
	{#define _activate()            JiecTest_activate(_JIECTEST_)}
	{#define _next_cycle()          JiecTest_nextCycle(_JIECTEST_)}
	{#define _no_tests()            JiecTest_empty(_JIECTEST_)}
	// The last line of the output when older lines of the console have been
	// overwritten. _bye() prints it, so that every way of ending the run does.
	// jier prints every line to the standard output, where nothing is lost,
	// so it warns only when JIECUNIT_JIER_CONSOLE_WARNING is defined (tests).
{#if !defined(_JIER) || defined(JIECUNIT_JIER_CONSOLE_WARNING)}
	{#define _JIECUNIT_WARN_IF_CONSOLE_WRAPPED()
		if _CONSOLE_.wrapped then
			puts(jiec_concat('[ WARNING] The console buffer is full (CONSOLE_MAX_ROWS=', dint_to_string(CONSOLE_MAX_ROWS), '); older lines may have been overwritten.'));
		end_if}
{#else}
	{#define _JIECUNIT_WARN_IF_CONSOLE_WRAPPED()}
{#endif}
	// Report an error of the runner about the active test and count it as a
	// failure. It is printed with puts, not JiecTest_print: it is about the
	// test program, not an assertion of the test.
	{#define _runner_error(text)    puts(jiec_concat('[  ERROR ] ', text)); inc(_JIECTEST_.num_of_failures); JiecTest_deactivate(_JIECTEST_)}
	// The end of the run: publish it in g_jiecunit_result, then stop. A rerun
	// requested while the tests were running is discarded: only a request
	// made after the run has finished starts another run.
	{#define _publish_end(rc)       _JIECUNIT_RERUN_ := false; _JIECUNIT_RESULT_.all_passed := (rc = 0); _JIECUNIT_RESULT_.state := 2}
{#if defined(_JIER) && !defined(JIECUNIT_NO_HALT)}
	// jier (Jiecc 9.4.0 or later is required): stop the scan loop at once and
	// make the code the exit code of `jiecc --run` (0: all tests passed, 1:
	// failures or a fatal error). Any statement after _bye() in the same scan
	// does not run. Define JIECUNIT_NO_HALT to keep running as on a PLC.
	{#define _bye(rc)               _JIECUNIT_WARN_IF_CONSOLE_WRAPPED(); _publish_end(rc); halt(code := rc)}
{#else}
	// PLC targets: keep returning at the top of every scan, until
	// g_jiecunit_rerun requests another run.
	{#define _bye(rc)               _JIECUNIT_WARN_IF_CONSOLE_WRAPPED(); _publish_end(rc); done := true; return}
{#endif}
	_DEFINE_SYS_IN_POU_();
	_DECLARE_CONSOLE_IN_POU_();
	_DECLARE_EXTERNAL_JIEC_TESTNAMES();
	_DECLARE_EXTERNAL_JIEC_TEST();
	DECLARE_EXTERNAL_JIECUNIT_RESULT();
	var
		//
		// With JIECUNIT_MANUAL_START, nothing runs until g_jiecunit_rerun is set.
{#ifdef JIECUNIT_MANUAL_START}
		done: bool := true;
{#else}
		done: bool := false;
{#endif}
		//
		testname_index: dint;
		testname: string[TESTNAME_MAX_SIZE];
		register_result: dint;
		//
		is_first_scan: bool := true;
		// Whether a test was active when this program finished its previous
		// scan, i.e. whether the test program should have run since then.
		test_expected_to_run: bool := false;
		//
		test_index: dint;
		tmp_string: string[STRING_MAX_SIZE];
		//
		active_test_failures0, active_test_failures1: dint;
		active_test_time0, active_test_time1: _JIECUNIT_CLOCK_T;
		active_test_accumulated_time_in_us: udint;
		tests_time_in_us: udint;
		//
		num_of_failed_tests: dint := 0;
		failed_testnames: array[MAX_TESTS] of string[TESTNAME_MAX_SIZE];
		// The count of tests reported as skipped, i.e. tests where _JIECTEST_.tmp_is_skipped was set (see JiecTest_skip).
		num_of_skipped_tests: dint := 0;
	end
	if done then
		if not _JIECUNIT_RERUN_ then
			return;
		end_if;
		// Run every test again. The variables of the test programs are not
		// initialized again; a fixture is, at the start of each of its tests.
		_JIECUNIT_RERUN_ := false;
		done := false;
		is_first_scan := true;
	end_if;
	if is_first_scan then
		reset_console(); // kludge: initialize console
		//
		tests_time_in_us := 0;
		num_of_failed_tests := 0;
		num_of_skipped_tests := 0;
		test_expected_to_run := false;
		_JIECUNIT_RESULT_.state := 1;
		_JIECUNIT_RESULT_.num_of_tests := 0;
		_JIECUNIT_RESULT_.num_of_passed := 0;
		_JIECUNIT_RESULT_.num_of_failed := 0;
		_JIECUNIT_RESULT_.num_of_skipped := 0;
		_JIECUNIT_RESULT_.elapsed_us := 0;
		_JIECUNIT_RESULT_.all_passed := false;
		inc(_JIECUNIT_RESULT_.run_count);
		_initialize();
		// register tests
		for testname_index := 0 to MAX_TESTS - 1 do
			testname := _JIECTESTNAMES_[testname_index];
			if (testname <> '') and (testname <> this_name) then
				register_result := _register(testname);
				if register_result = -1 then
					puts(jiec_concat('Fatal error: program $'', testname, '$' is already registered.'));
					_bye(1);
				elsif register_result = -2 then
					puts(jiec_concat('Fatal error: too many tests. MAX_TESTS=', dint_to_string(MAX_TESTS), '.'));
					_bye(1);
				end_if;
			end_if;
		end_for;
		puts(jiec_concat('[========] Running ', dint_to_string(_num_of_tests()), ' tests.'));
		_JIECUNIT_RESULT_.num_of_tests := _num_of_tests();
		is_first_scan := false;
	else
		// epilogue: check the cycle that has just run and finish the test if it ended.
		repeat
			if _no_tests() then
				// Nothing to run: report an empty run and stop (the exit code is 0, as in Google Test).
				puts('[========] 0 tests ran.');
				puts('[ PASSED ] 0 tests.');
				_bye(0);
			end_if;
			if test_expected_to_run then
				// 1, 2. The test program must have run exactly once.
				if _JIECTEST_.tmp_exec_count = 0 then
					if JiecTest_currentCycle(_JIECTEST_) = 0 then
						// The test program never ran, so it has not printed its RUN line.
						puts(jiec_concat('[ RUN    ] ', _display_name()));
						_runner_error(jiec_concat('The program $'', _active_testname(), '$' was not found in active tasks.'));
					else
						_runner_error(jiec_concat('The program $'', _active_testname(), '$' did not run in cycle ', dint_to_string(JiecTest_currentCycle(_JIECTEST_)), '. Assign it to the task of JiecUnitMain.'));
					end_if;
					// A program that does not run cannot run its TearDown either:
					// do not wait for it (and do not report it a second time).
					_JIECTEST_.tmp_teardown_pending := false;
				elsif _JIECTEST_.tmp_exec_count > 1 then
					_runner_error(jiec_concat('The program $'', _active_testname(), '$' ran ', dint_to_string(_JIECTEST_.tmp_exec_count), ' times in one cycle of JiecUnitMain. Assign it to the task of JiecUnitMain.'));
				end_if;
			end_if;
			_JIECTEST_.tmp_exec_count := 0;
			// 3. A capture left open by a statement that returned from the test.
			JiecTest_endLeftCapture(_JIECTEST_);

			active_test_time1 := _JIECUNIT_CLOCK_NOW();
			active_test_accumulated_time_in_us := active_test_accumulated_time_in_us + _JIECUNIT_CLOCK_DIFF_US(active_test_time1, active_test_time0);
			active_test_time0 := active_test_time1;

			// 4. Advance the cycle; end a test that cannot go on.
			if _is_active() then
				if not _next_cycle() then
					JiecTest_failure(self:=_JIECTEST_, message:='The cycle counter of the test overflowed.', die:=false, file:=_JIECTEST_.tmp_test_file, line:=_JIECTEST_.tmp_test_line);
					JiecTest_deactivate(_JIECTEST_);
				elsif _JIECTEST_.tmp_is_single_cycle then
					// A TEST_S that returned before END_TEST_S has ended normally.
					JiecTest_deactivate(_JIECTEST_);
				elsif (_JIECTEST_.tmp_max_cycles > 0) and (JiecTest_currentCycle(_JIECTEST_) >= _JIECTEST_.tmp_max_cycles) then
					JiecTest_failure(self:=_JIECTEST_, message:=jiec_concat('The test did not finish within ', dint_to_string(_JIECTEST_.tmp_max_cycles), ' cycles (JIECUNIT_MAX_CYCLES_PER_TEST, SET_TEST_MAX_CYCLES). Call EOT() to end a TEST_M test.'), die:=false, file:=_JIECTEST_.tmp_test_file, line:=_JIECTEST_.tmp_test_line);
					JiecTest_deactivate(_JIECTEST_);
				end_if;
			end_if;

			if _is_active() then
				exit;
			end_if;

			// 5. Wait for the TearDown of a fixture: it runs in the test program
			// after this program in the same cycle (or, if this program is the
			// last of the task, it has run before it).
			if _JIECTEST_.tmp_teardown_pending then
				inc(_JIECTEST_.tmp_teardown_waits);
				if _JIECTEST_.tmp_teardown_waits <= 1 then
					exit;
				end_if;
				_runner_error(jiec_concat('The TearDown of the fixture of $'', _active_testname(), '$' did not run.'));
				_JIECTEST_.tmp_teardown_pending := false;
			end_if;

			// 6. Finish the test. A failure takes precedence over a skip.
			tests_time_in_us := tests_time_in_us + active_test_accumulated_time_in_us;

			active_test_failures1 := _num_of_failures();
			if active_test_failures0 <> active_test_failures1 then
				failed_testnames[num_of_failed_tests] := _display_name();
				inc(num_of_failed_tests);
				puts(jiec_concat('[ FAILED ] ', _display_name(), ' ', _JIECUNIT_ELAPSED_TEXT(active_test_accumulated_time_in_us)));
			elsif _JIECTEST_.tmp_is_skipped then
				inc(num_of_skipped_tests);
				puts(jiec_concat('[ SKIPPED] ', _display_name(), ' ', _JIECUNIT_ELAPSED_TEXT(active_test_accumulated_time_in_us)));
			else
				puts(jiec_concat('[     OK ] ', _display_name(), ' ', _JIECUNIT_ELAPSED_TEXT(active_test_accumulated_time_in_us)));
			end_if;
			_JIECUNIT_RESULT_.num_of_failed := num_of_failed_tests;
			_JIECUNIT_RESULT_.num_of_skipped := num_of_skipped_tests;
			_JIECUNIT_RESULT_.num_of_passed := _active_test_index() + 1 - num_of_failed_tests - num_of_skipped_tests;
			_JIECUNIT_RESULT_.elapsed_us := tests_time_in_us;

			if _active_test_index() = _num_of_tests() - 1 then
				// finish
				tmp_string := jiec_concat(' ', _JIECUNIT_ELAPSED_TEXT(tests_time_in_us));
				puts(jiec_concat('[========] ', dint_to_string(_num_of_tests()), ' tests ran.', tmp_string));
				puts(jiec_concat('[ PASSED ] ', dint_to_string(_num_of_tests() - num_of_failed_tests - num_of_skipped_tests), ' tests.'));
				if num_of_skipped_tests > 0 then
					puts(jiec_concat('[ SKIPPED] ', dint_to_string(num_of_skipped_tests), ' tests.'));
				end_if;
				if _num_of_failures() > 0 then
					puts(jiec_concat('[ FAILED ] ', dint_to_string(num_of_failed_tests), ' tests, listed below.'));
					for test_index := 0 to num_of_failed_tests - 1 do
						puts(jiec_concat('[ FAILED ] ', failed_testnames[test_index]));
					end_for;
					_bye(1);
				end_if;
				_bye(0);
			end_if;
		until true end_repeat;
	end_if;

	// prologue: start the next test.
	repeat if _no_tests() then exit; end_if;
		if (_active_test_index() = -1) or ((_active_test_index() < _num_of_tests() - 1) and (not _is_active()) and (not _JIECTEST_.tmp_teardown_pending)) then
			// run the next test case. Reset every per-test field before activating it.
			// The test program prints its RUN line when it first runs.
			inc(_JIECTEST_.tmp_active_test_index);
			JiecTest_beginTest(_JIECTEST_);
			active_test_failures0 := _num_of_failures();
			active_test_accumulated_time_in_us := 0;
			active_test_time0 := _JIECUNIT_CLOCK_NOW();
			_activate();
		end_if;
	until true end_repeat;
	test_expected_to_run := _is_active();
	{#undef _initialize}
	{#undef _register}
	{#undef _active_test_index}
	{#undef _active_testname}
	{#undef _display_name}
	{#undef _num_of_tests}
	{#undef _num_of_failures}
	{#undef _is_active}
	{#undef _activate}
	{#undef _next_cycle}
	{#undef _no_tests}
	{#undef _runner_error}
	{#undef _JIECUNIT_WARN_IF_CONSOLE_WRAPPED}
	{#undef _bye}
	{#undef _publish_end}
end

{#include "jiecunit_macros.iec"}

{#ifdef _JIER}
	{#define _JIECUNIT_DEFINE_TASKS(...)
		_JIECUNIT_EXTERN_PROGRAMS(__VA_ARGC__, __VA_ARGS__);
		task JiecUnitTask(priority := 0);
		program JiecUnitMain with JiecUnitTask: JiecUnitMain();
		_JIECUNIT_TASK_BIND_(__VA_ARGS__)
	}
{#else}
	// Oops! No vendor supports task definitions.
	{#define _JIECUNIT_DEFINE_TASKS(...)}
{#endif}

{#endif}
