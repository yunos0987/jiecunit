{#ifndef __JIECUNIT_CONFIG_IEC__}
{#define __JIECUNIT_CONFIG_IEC__}

{#define _JIECUNIT          true}
{#define _JIECUNIT_FULL_VER 70000}
{#define _JIECUNIT_VER      700}
{#define _JIECUNIT_VERSION  "7.0.0"}

{#ifdef _JIECC}
{#if _JIECC_FULL_VER < 90400}
{#error JiecUnit requires Jiecc 9.4.0 or later.}
{#endif}
{#endif}

{#define MAX_TESTS 512}

// The maximum number of cycles a test may run: a test that is still running
// after this many cycles (a TEST_M that never calls EOT()) is reported as a
// failure. 0 or a negative value means no limit. A test can change its own
// limit with SET_TEST_MAX_CYCLES(n). The default is smaller on jier, which
// runs only about 50 cycles per second.
{#ifndef JIECUNIT_MAX_CYCLES_PER_TEST}
{#ifdef _JIER}
{#define JIECUNIT_MAX_CYCLES_PER_TEST 1000}
{#else}
{#define JIECUNIT_MAX_CYCLES_PER_TEST 100000}
{#endif}
{#endif}

{#define TESTNAME_MAX_SIZE 128}
{#define FILENAME_MAX_SIZE 128}

{#endif}
