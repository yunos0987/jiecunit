{#ifndef __JIECUNIT_CONFIG_IEC__}
{#define __JIECUNIT_CONFIG_IEC__}

{#define _JIECUNIT          true}
{#define _JIECUNIT_FULL_VER 80000}
{#define _JIECUNIT_VER      800}
{#define _JIECUNIT_VERSION  "8.0.0"}

{#ifdef _JIECC}
{#if _JIECC_FULL_VER < 90400}
{#error JiecUnit requires Jiecc 9.4.0 or later.}
{#endif}
{#endif}

{#include <sys_config.iec>}

// The values below can be overridden with -D NAME=VALUE.

// The maximum number of tests. The generated helper macros of
// _JIEC_TESTNAMES_LIST_ (src/jiecunit_macros.iec) support up to 512.
{#ifndef MAX_TESTS}
{#define MAX_TESTS 512}
{#endif}
{#if MAX_TESTS > 512}
// (The message must not name the macro: {#error} expands macros in its text.)
{#error JiecUnit: the maximum number of tests is 512, the limit of the macros generated by scripts/generate_macros.py.}
{#endif}

// The maximum number of cycles a test may run: a test that is still running
// after this many cycles (a TEST_M that never calls EOT()) is reported as a
// failure. 0 or a negative value means no limit. A test can change its own
// limit with SET_TEST_MAX_CYCLES(n). The default is smaller on jier, which
// runs only about 50 cycles per second.
{#ifndef JIECUNIT_MAX_CYCLES_PER_TEST}
{#ifdef _JIER}
{#define JIECUNIT_MAX_CYCLES_PER_TEST 1000}
{#else}
{#define JIECUNIT_MAX_CYCLES_PER_TEST 100000}
{#endif}
{#endif}

// The maximum length of a test name and of a source file name.
{#ifndef TESTNAME_MAX_SIZE}
{#define TESTNAME_MAX_SIZE 128}
{#endif}
{#ifndef FILENAME_MAX_SIZE}
{#define FILENAME_MAX_SIZE 128}
{#endif}
{#if TESTNAME_MAX_SIZE > STRING_MAX_SIZE}
{#error JiecUnit: the maximum length of a test name must not exceed the maximum length of a STRING.}
{#endif}
{#if FILENAME_MAX_SIZE > STRING_MAX_SIZE}
{#error JiecUnit: the maximum length of a file name must not exceed the maximum length of a STRING.}
{#endif}

// The maximum nesting depth of ASSERT_NO_FATAL_FAILURE / EXPECT_NO_FATAL_FAILURE.
{#ifndef JIECUNIT_MAX_NO_FATAL_FAILURE_DEPTH}
{#define JIECUNIT_MAX_NO_FATAL_FAILURE_DEPTH 8}
{#endif}
{#if JIECUNIT_MAX_NO_FATAL_FAILURE_DEPTH < 1}
{#error JiecUnit: the maximum nesting depth of the no-fatal-failure statements must be 1 or more.}
{#endif}

// The maximum nesting depth of SCOPED_TRACE.
{#ifndef JIECUNIT_MAX_TRACE_DEPTH}
{#define JIECUNIT_MAX_TRACE_DEPTH 8}
{#endif}
{#if JIECUNIT_MAX_TRACE_DEPTH < 1}
{#error JiecUnit: the maximum nesting depth of the scoped traces must be 1 or more.}
{#endif}

// The maximum length of the text of an expression shown in a failure. The
// text is passed as a string literal, and Sysmac Studio (OMRON) does not
// build a literal that is longer than the STRING input it is passed to, so
// the default is the maximum length of a STRING.
{#ifndef EXPRESSION_MAX_SIZE}
{#define EXPRESSION_MAX_SIZE STRING_MAX_SIZE}
{#endif}
{#if EXPRESSION_MAX_SIZE > STRING_MAX_SIZE}
{#error JiecUnit: the maximum length of an expression text must not exceed the maximum length of a STRING.}
{#endif}

// The maximum length of the text of a SCOPED_TRACE that is kept while its
// statement runs (a longer text is cut off).
{#ifndef JIECUNIT_TRACE_TEXT_MAX_SIZE}
{#define JIECUNIT_TRACE_TEXT_MAX_SIZE 128}
{#endif}
{#if JIECUNIT_TRACE_TEXT_MAX_SIZE > STRING_MAX_SIZE}
{#error JiecUnit: the maximum length of a trace text must not exceed the maximum length of a STRING.}
{#endif}

{#endif}
