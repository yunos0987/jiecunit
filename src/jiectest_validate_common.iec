{#ifndef __JIECTEST_VALIDATE_COMMON_IEC__}
{#define __JIECTEST_VALIDATE_COMMON_IEC__}
(*
Shared definitions for the validator functions JiecTest_validate<CMP>_<DATATYPE>.
Each validator is generated by a function-like macro whose body is a whole
function definition. The lines of a macro body end with `$n$` so that the
generated function keeps one declaration or statement per line.
Note: the preprocessor does not substitute macro parameters inside a doc
pragma, so the doc text in the macro bodies does not name the datatype.
*)
{#include <sys.iec>}
{#include <sys_conv.iec>}

// The function name JiecTest_validate<CMP>_<DATATYPE> is pasted with @@
// directly from the macro parameters, so DATATYPE is not macro-expanded
// first. This keeps the TIME validators named *_TIME on CODESYS, where
// sys_conv.iec defines TIME as ltime, matching the callers in
// jiecunit_core.iec (which paste the same way).

// Wraps the validators of the datatypes that are not generated for KEYENCE
// and MITSUBISHI.
{#if not (_KEYENCE or _MITSUBISHI)}
	{#define _JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(...) __VA_ARGS__}
{#else}
	{#define _JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(...)}
{#endif}

// Wraps the TIME comparison validators, which need time_to_string_sec;
// sys_conv.iec does not define it for MITSUBISHI.
{#if not _MITSUBISHI}
	{#define _JIECTEST_UNLESS_MITSUBISHI_(...) __VA_ARGS__}
{#else}
	{#define _JIECTEST_UNLESS_MITSUBISHI_(...)}
{#endif}

// Expands M(DATATYPE, type, to_string) for every datatype of EQ/NE.
{#define _JIECTEST_FOR_EQ_TYPES_(M)
	M(INT32, dint, dint_to_string)
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(INT64, lint, lint_to_string))
	M(UINT32, udint, udint_to_string)
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(UINT64, ulint, ulint_to_string))
	M(DOUBLE, lreal, lreal_to_string)
	M(BOOL, bool, bool_to_string)
	M(BIT32, dword, dword_to_string)
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(BIT64, lword, lword_to_string))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(TIME, time, time_to_string_sec))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(DATE, date, date_to_string))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(TOD, time_of_day, tod_to_string))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(M(DT, date_and_time, dt_to_string))
	M(STRING, string[STRING_MAX_SIZE], )
}

// Defines JiecTest_validate<CMP>_<DATATYPE> for LT/LE/GE/GT. OP is the ST
// operator and LABEL the string printed for it on failure.
{#define _JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, DATATYPE, TYPE, TOSTR)
(*${doc Validate a comparison between two values using the specified operator.$n$
@inout self The JiecTest_t structure.$n$
@input lval The left-hand side value.$n$
@input rval The right-hand side value.$n$
@input message The failure message.$n$
@input die Whether to abort the test on failure.$n$
@input file The source file name.$n$
@input line The line number.$n$
@return True if the comparison holds, false otherwise.$n$
$}*)$n$
function JiecTest_validate@@CMP@@_@@DATATYPE: bool$n$
	_PROLOGUE_OF_FUNCTION_()$n$
	_DECLARE_CONSOLE_IN_POU_()$n$
	var_in_out self: JiecTest_t; end$n$
	var_input$n$
		(*${doc The left-hand side value.$}*)$n$
		lval: TYPE;$n$
		(*${doc The right-hand side value.$}*)$n$
		rval: TYPE;$n$
		(*${doc The failure message.$}*)$n$
		message: string[128];$n$
		(*${doc Whether to abort the test on failure.$}*)$n$
		die: bool := true;$n$
		(*${doc The source file name.$}*)$n$
		file: string[FILENAME_MAX_SIZE];$n$
		(*${doc The line number.$}*)$n$
		line: dint;$n$
	end$n$
	JiecTest_validate@@CMP@@_@@DATATYPE := lval OP rval;$n$
	if JiecTest_validate@@CMP@@_@@DATATYPE then$n$
		return;$n$
	end_if;$n$
$n$
	puts(jiec_concat('Expected: lhs ', LABEL, ' rhs'));$n$
	puts(jiec_concat('Actual: ', TOSTR(lval), ' vs ', TOSTR(rval)));$n$
$n$
	JiecTest_failure(self:=self, message:=message, die:=die, file:=file, line:=line);$n$
end$n$
}

// Expands _JIECTEST_DEFINE_VALIDATE_CMP_ for every datatype of LT/LE/GE/GT.
{#define _JIECTEST_FOR_CMP_TYPES_(CMP, OP, LABEL)
	_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, INT32, dint, dint_to_string)
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, INT64, lint, lint_to_string))
	_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, UINT32, udint, udint_to_string)
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, UINT64, ulint, ulint_to_string))
	_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, DOUBLE, lreal, lreal_to_string)
	_JIECTEST_UNLESS_MITSUBISHI_(_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, TIME, time, time_to_string_sec))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, DATE, date, date_to_string))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, TOD, time_of_day, tod_to_string))
	_JIECTEST_UNLESS_KEYENCE_MITSUBISHI_(_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, DT, date_and_time, dt_to_string))
	_JIECTEST_DEFINE_VALIDATE_CMP_(CMP, OP, LABEL, STRING, string[STRING_MAX_SIZE], )
}

{#endif}
