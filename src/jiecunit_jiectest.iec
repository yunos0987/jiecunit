{#include "jiectest_validate_eq.iec"}
{#include "jiectest_validate_ne.iec"}
{#include "jiectest_validate_lt.iec"}
{#include "jiectest_validate_le.iec"}
{#include "jiectest_validate_ge.iec"}
{#include "jiectest_validate_gt.iec"}
{#include "jiectest_validate_near.iec"}
{#include "jiectest_validate_near_rel.iec"}
{#include "jiectest_validate_ulp.iec"}
{#include "jiectest_validate_str.iec"}

{#endif}
