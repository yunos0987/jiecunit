{#ifndef __SYS_CONV_IEC__}
{#define __SYS_CONV_IEC__}

{#include "sys.iec"}

{#if _KEYENCE}
	{#define word uint}
	{#define int_to_word(...) int_to_uint(__VA_ARGS__)}
	{#define uint_to_word(...) uint_to_uint(__VA_ARGS__)}
	{#define word_to_int(...) uint_to_int(__VA_ARGS__)}
	{#define word_to_uint(...) uint_to_uint(__VA_ARGS__)}

	{#define dword udint}
	{#define dint_to_dword(...) dint_to_udint(__VA_ARGS__)}
	{#define udint_to_dword(...) udint_to_udint(__VA_ARGS__)}
	{#define dword_to_dint(...) udint_to_dint(__VA_ARGS__)}
	{#define dword_to_udint(...) udint_to_udint(__VA_ARGS__)}

	(*{doc Convert a 32-bit signed integer to a decimal string representation.
	@input in The 32-bit signed integer to convert.
	@return The string representation of the input value.}*)
	function dint_to_string: string[16]
		_PROLOGUE_OF_FUNCTION_FOR_SYS_();
		var_input
			(*{doc The 32-bit signed integer to convert.}*)
			in: dint;
		end
		dint_to_string := NumToDecString(in:=in, zerosuppress:=true, plussignomission:=true);
	end

	(*{doc Convert a 32-bit unsigned integer to a decimal string representation.
	@input in The 32-bit unsigned integer to convert.
	@return The string representation of the input value.}*)
	function udint_to_string: string[16]
		_PROLOGUE_OF_FUNCTION_FOR_SYS_();
		var_input
			(*{doc The 32-bit unsigned integer to convert.}*)
			in: udint;
		end
		udint_to_string := NumToDecString(in:=in, zerosuppress:=true, plussignomission:=true);
	end

	(*{doc Convert a 64-bit floating-point value to a string representation.
	@input in The 64-bit floating-point value to convert.
	@return The string representation of the input value.}*)
	function lreal_to_string: string[32]
		_PROLOGUE_OF_FUNCTION_FOR_SYS_();
		var_input
			(*{doc The 64-bit floating-point value to convert.}*)
			in: lreal;
		end
		lreal_to_string := LrealToString(in:=in, format:=1, fullcount:=24, subdeccount:=14);
	end

	{#define dword_to_string(...) udint_to_string(__VA_ARGS__)}
{#endif}

{#if not (_CODESYS)}
(*{doc Convert a boolean value to a string representation.
@input in The boolean value to convert.
@return 'true' if the input is true, 'false' otherwise.}*)
function bool_to_string: string[8]
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The boolean value to convert.}*)
		in: bool;
	end
	if in then
		bool_to_string := 'true';
	else
		bool_to_string := 'false';
	end_if;
end
{#endif}

// note: _JIER provides time_to_usec_dint natively as a stdpou foreign function. Do not add an 'Unsupported' stub here.
{#if _OMRON}
	{#define time_to_usec_dint(...) lint_to_dint(TimeToNanoSec(__VA_ARGS__) / lint#1000)}
{#elif _KEYENCE}
	{#define time_to_usec_dint(...) TimeToMicroSec(__VA_ARGS__)}
{#elif _CODESYS}
	{#define time ltime}
	{#define TIME ltime}
	{#define time_to_usec_dint(...) lint_to_dint(ltime_to_lint(__VA_ARGS__) / lint#1000)}
{#endif}

{#if not (_MITSUBISHI)}
(*{doc How many times a duration contains a unit, rounded down.
Uses only the subtraction and the comparison of TIME values, so that it works
without 64-bit integers and never computes a duration longer than value.
@input value The duration; must not be negative.
@input unit The unit; must be positive.
@return The number of whole units in value (at most 2147483647).}*)
function jiec_time_quotient: dint
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The duration; must not be negative.}*)
		value: time;
		(*{doc The unit; must be positive.}*)
		unit: time;
	end
	var_temp
		remaining: time;
		chunk: time;
		chunk_count: dint;
	end
	jiec_time_quotient := 0;
	remaining := value;
	while remaining >= unit do
		// Take the largest unit * 2^k that fits (the subtraction avoids a
		// duration above the range of TIME).
		chunk := unit;
		chunk_count := 1;
		while chunk_count < 1073741824 do
			if (remaining - chunk) < chunk then
				exit;
			end_if;
			chunk := chunk + chunk;
			chunk_count := chunk_count * 2;
		end_while;
		if jiec_time_quotient > 2147483647 - chunk_count then
			jiec_time_quotient := 2147483647;
			return;
		end_if;
		remaining := remaining - chunk;
		jiec_time_quotient := jiec_time_quotient + chunk_count;
	end_while;
end

(*{doc Convert a time value to text in the form of a duration literal of IEC 61131-3.
The form is "T#[-][<d>d][<h>h][<m>m][<s>s][<ms>ms]", for example
"T#1h30m5s250ms"; a part that is 0 is left out, and 0 is "T#0s". A fraction of
a millisecond is written with a decimal point, down to nanoseconds
("T#250.123456ms"); the units us and ns are not used. Unlike a conversion
through an integer of microseconds, long durations are not cut off.
@input in The time value to convert.
@return The text.}*)
function time_to_literal: string[64]
	_PROLOGUE_OF_FUNCTION_FOR_SYS_();
	var_input
		(*{doc The time value to convert.}*)
		in: time;
	end
	var_temp
		remaining: time;
		days: dint;
		seconds: dint;
		usec: dint;
		nsec: dint;
		fraction: dint;
		fraction_str: string[16];
		text: string[64];
	end
	text := 'T#';
	remaining := in;
	if in < time#0s then
		text := 'T#-';
		remaining := time#0s - in;
	end_if;
	if remaining = time#0s then
		time_to_literal := 'T#0s';
		return;
	end_if;

	days := jiec_time_quotient(remaining, time#1d);
	if days > 0 then
		remaining := remaining - time#1d * days;
		text := jiec_concat(text, dint_to_string(days), 'd');
	end_if;
	// Less than a day is left.
	seconds := jiec_time_quotient(remaining, time#1s);
	remaining := remaining - time#1s * seconds;
	if seconds >= 3600 then
		text := jiec_concat(text, dint_to_string(seconds / 3600), 'h');
		seconds := seconds mod 3600;
	end_if;
	if seconds >= 60 then
		text := jiec_concat(text, dint_to_string(seconds / 60), 'm');
		seconds := seconds mod 60;
	end_if;
	if seconds > 0 then
		text := jiec_concat(text, dint_to_string(seconds), 's');
	end_if;
	// Less than a second is left: it fits in a DINT of microseconds. What is
	// left below a microsecond is read as nanoseconds after multiplying it.
	usec := time_to_usec_dint(remaining);
	remaining := remaining - (time#1ms * usec) / 1000;
	nsec := time_to_usec_dint(remaining * 1000);
	fraction := (usec mod 1000) * 1000 + nsec;
	if (usec >= 1000) or (fraction > 0) then
		text := jiec_concat(text, dint_to_string(usec / 1000));
		if fraction > 0 then
			fraction_str := dint_to_string(fraction);
			while len(fraction_str) < 6 do
				fraction_str := jiec_concat('0', fraction_str);
			end_while;
			while right(fraction_str, 1) = '0' do
				fraction_str := left(fraction_str, len(fraction_str) - 1);
			end_while;
			text := jiec_concat(text, '.', fraction_str);
		end_if;
		text := jiec_concat(text, 'ms');
	end_if;
	time_to_literal := text;
end
